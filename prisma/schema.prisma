generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Parent {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @unique
  email     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  children  Child[]
  surveys   Survey[]

  @@map("parents")
}

model Child {
  id        Int       @id @default(autoincrement())
  parentId  Int       @map("parent_id")
  name      String
  birthDate DateTime  @map("birth_date") @db.Date
  gender    String    @db.VarChar(1)
  createdAt DateTime  @default(now()) @map("created_at")
  parent    Parent    @relation(fields: [parentId], references: [id])
  surveys   Survey[]

  @@map("children")
}

model HasabCategory {
  id          Int        @id @default(autoincrement())
  code        String     @unique @db.VarChar(20)
  name        String     @db.VarChar(100)
  description String?
  questions   Question[]

  @@map("hasab_categories")
}

model Question {
  id         Int            @id @default(autoincrement())
  categoryId Int?           @map("category_id")
  order      Int
  text       String
  type       String         @db.VarChar(10)
  category   HasabCategory? @relation(fields: [categoryId], references: [id])
  answers    SurveyAnswer[]

  @@map("questions")
}

model Survey {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @default(uuid()) @map("public_id")
  childId     Int       @map("child_id")
  parentId    Int       @map("parent_id")
  voucherId   Int?      @map("voucher_id")
  schoolId    Int?      @map("school_id")
  schoolCode  String?   @map("school_code") @db.VarChar(50)
  status      String    @default("in_progress") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  child       Child     @relation(fields: [childId], references: [id])
  parent      Parent    @relation(fields: [parentId], references: [id])
  voucher     Voucher?  @relation(fields: [voucherId], references: [id])
  school      School?   @relation(fields: [schoolId], references: [id])
  answers     SurveyAnswer[]
  responses   ChildNaturalResponse[]
  result      SurveyResult?
  pdfReports        PdfReport[]
  notifications     NotificationLog[]
  schoolStudent     SurveyStudent?
  familyAssessment  FamilyAssessment?

  @@map("surveys")
}

model School {
  id            Int           @id @default(autoincrement())
  name          String
  npsn          String?       @unique @db.VarChar(20)
  city          String?
  code          String        @unique @db.VarChar(30)
  plan          String        @default("starter") @db.VarChar(20)
  studentCap    Int           @default(30) @map("student_cap")
  billingStatus String        @default("trial") @db.VarChar(20) @map("billing_status")
  adminEmail    String        @map("admin_email")
  adminPhone    String        @map("admin_phone")
  createdAt     DateTime      @default(now()) @map("created_at")
  classes       SchoolClass[]
  users         SchoolUser[]
  surveys       Survey[]

  @@map("schools")
}

model SchoolClass {
  id       Int              @id @default(autoincrement())
  schoolId Int              @map("school_id")
  name     String
  grade    Int
  year     String           @db.VarChar(10)
  school   School           @relation(fields: [schoolId], references: [id])
  students SurveyStudent[]

  @@map("school_classes")
}

model SurveyStudent {
  id            Int         @id @default(autoincrement())
  surveyId      Int         @unique @map("survey_id")
  schoolClassId Int         @map("school_class_id")
  consentGiven  Boolean     @default(false) @map("consent_given")
  survey        Survey      @relation(fields: [surveyId], references: [id])
  schoolClass   SchoolClass @relation(fields: [schoolClassId], references: [id])

  @@map("survey_students")
}

model SchoolUser {
  id           Int      @id @default(autoincrement())
  schoolId     Int      @map("school_id")
  email        String   @unique
  name         String
  role         String   @db.VarChar(20)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  school       School   @relation(fields: [schoolId], references: [id])

  @@map("school_users")
}

model Voucher {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(20)
  status    String    @default("active") @db.VarChar(20)
  quota     Int       @default(1)
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  partnerId Int?      @map("partner_id")
  partner   Partner?  @relation(fields: [partnerId], references: [id])
  surveys   Survey[]

  @@map("vouchers")
}

model Partner {
  id             Int          @id @default(autoincrement())
  name           String
  institution    String?
  type           String       @db.VarChar(20) // institutional | affiliate
  email          String       @unique
  phone          String
  passwordHash   String       @map("password_hash")
  referralCode   String       @unique @map("referral_code") @db.VarChar(30)
  status         String       @default("pending") @db.VarChar(20) // pending | active | suspended
  creditBalance  Int          @default(0) @map("credit_balance")
  commissionRate Int          @default(20000) @map("commission_rate")
  createdAt      DateTime     @default(now()) @map("created_at")
  vouchers       Voucher[]
  commissions    Commission[]

  @@map("partners")
}

model Commission {
  id        Int       @id @default(autoincrement())
  partnerId Int       @map("partner_id")
  surveyId  Int       @unique @map("survey_id")
  amount    Int
  status    String    @default("pending") @db.VarChar(20) // pending | paid
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  partner   Partner   @relation(fields: [partnerId], references: [id])

  @@map("commissions")
}

model SurveyAnswer {
  id         Int      @id @default(autoincrement())
  surveyId   Int      @map("survey_id")
  questionId Int      @map("question_id")
  value      Int      @db.SmallInt
  survey     Survey   @relation(fields: [surveyId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])

  @@unique([surveyId, questionId])
  @@map("survey_answers")
}

model ChildNaturalResponse {
  id             Int     @id @default(autoincrement())
  surveyId       Int     @map("survey_id")
  responseOption String  @map("response_option") @db.VarChar(255)
  freeText       String? @map("free_text")
  survey         Survey  @relation(fields: [surveyId], references: [id])

  @@map("child_natural_responses")
}

model SurveyResult {
  id                 Int      @id @default(autoincrement())
  surveyId           Int      @unique @map("survey_id")
  scoreAsyiha        Int      @map("score_asyiha") @db.SmallInt
  scoreIlmi          Int      @map("score_ilmi") @db.SmallInt
  scoreAmali         Int      @map("score_amali") @db.SmallInt
  scoreWajdan        Int      @map("score_wajdan") @db.SmallInt
  pctAsyiha          Decimal  @map("pct_asyiha") @db.Decimal(5, 2)
  pctIlmi            Decimal  @map("pct_ilmi") @db.Decimal(5, 2)
  pctAmali           Decimal  @map("pct_amali") @db.Decimal(5, 2)
  pctWajdan          Decimal  @map("pct_wajdan") @db.Decimal(5, 2)
  dominantHasab      String   @map("dominant_hasab") @db.VarChar(20)
  source             String   @default("ai") @db.VarChar(10)
  personaLabel       String   @map("persona_label") @db.VarChar(100)
  personaDescription String?  @map("persona_description")
  scoreNarrative     String?  @map("score_narrative")
  parentNotes        String?  @map("parent_notes")
  microdosingPlan    Json?    @map("microdosing_plan")
  fitGapNarrative    String?  @map("fit_gap_narrative")
  bridgingActions    Json?    @map("bridging_actions")
  lesRecommendations Json?    @map("les_recommendations")
  aiRawResponse      Json?    @map("ai_raw_response")
  aiModel            String?  @map("ai_model") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at")
  survey             Survey   @relation(fields: [surveyId], references: [id])

  @@map("survey_results")
}

model NotificationLog {
  id        Int      @id @default(autoincrement())
  surveyId  Int      @unique @map("survey_id")
  channel   String   @db.VarChar(20)
  sentAt    DateTime @default(now()) @map("sent_at")
  status    String   @default("sent") @db.VarChar(20)
  response  Json?    @map("response")
  survey    Survey   @relation(fields: [surveyId], references: [id])

  @@map("notification_logs")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String   @db.VarChar(6)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}

model PdfReport {
  id        Int       @id @default(autoincrement())
  surveyId  Int       @map("survey_id")
  filePath  String    @map("file_path") @db.VarChar(500)
  sentViaWa Boolean   @default(false) @map("sent_via_wa")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  survey    Survey    @relation(fields: [surveyId], references: [id])

  @@map("pdf_reports")
}

// ─── Modul Hasab Keluarga (Phase 0) ───────────────────────────────────────────

/// Soal untuk penilaian Hasab Keluarga (5 dimensi × 6 opsi = 30 soal)
model FamilyQuestion {
  id        Int            @id @default(autoincrement())
  dimension String         @db.VarChar(20) // ilmi | qiyadah | amali | wajdan | tarbiyah
  order     Int            // 1–6 dalam dimensi
  code      String         @unique @db.VarChar(10) // D1_O1 … D5_O6
  text      String
  answers   FamilyAnswer[]

  @@map("family_questions")
}

/// Satu sesi penilaian Hasab Keluarga, terhubung ke survey anak (opsional)
model FamilyAssessment {
  id          Int            @id @default(autoincrement())
  publicId    String         @unique @default(uuid()) @map("public_id")
  surveyId    Int            @unique @map("survey_id") // 1-to-1 dengan Survey
  status      String         @default("draft") @db.VarChar(20) // draft | completed
  createdAt   DateTime       @default(now()) @map("created_at")
  completedAt DateTime?      @map("completed_at")
  survey      Survey         @relation(fields: [surveyId], references: [id])
  figures     FamilyFigure[]
  result      FamilyResult?

  @@map("family_assessments")
}

/// Satu figur keluarga dalam satu sesi assessment
model FamilyFigure {
  id           Int              @id @default(autoincrement())
  assessmentId Int              @map("assessment_id")
  role         String           @db.VarChar(20) // kakek_ayah | nenek_ayah | kakek_ibu | nenek_ibu | ayah | ibu
  isKnown      Boolean          @default(true) @map("is_known") // false = figur tidak dikenal / sudah meninggal
  completedAt  DateTime?        @map("completed_at")
  assessment   FamilyAssessment @relation(fields: [assessmentId], references: [id])
  answers      FamilyAnswer[]

  @@unique([assessmentId, role])
  @@map("family_figures")
}

/// Satu jawaban Likert (1–5) untuk satu soal dari satu figur
model FamilyAnswer {
  id         Int            @id @default(autoincrement())
  figureId   Int            @map("figure_id")
  questionId Int            @map("question_id")
  value      Int            @db.SmallInt // 1–5
  figure     FamilyFigure   @relation(fields: [figureId], references: [id])
  question   FamilyQuestion @relation(fields: [questionId], references: [id])

  @@unique([figureId, questionId])
  @@map("family_answers")
}

/// Hasil kalkulasi deterministik Hasab Keluarga
model FamilyResult {
  id              Int              @id @default(autoincrement())
  assessmentId    Int              @unique @map("assessment_id")
  scoreIlmi       Decimal          @map("score_ilmi") @db.Decimal(6, 2)
  scoreQiyadah    Decimal          @map("score_qiyadah") @db.Decimal(6, 2)
  scoreAmali      Decimal          @map("score_amali") @db.Decimal(6, 2)
  scoreWajdan     Decimal          @map("score_wajdan") @db.Decimal(6, 2)
  scoreTarbiyah   Decimal          @map("score_tarbiyah") @db.Decimal(6, 2)
  top3Hasab       String[]         @map("top3_hasab") // ['ilmi','qiyadah','amali']
  fitGapStatus    String           @map("fit_gap_status") @db.VarChar(20) // OPTIMAL | GAP
  fitGapScore     Decimal          @map("fit_gap_score") @db.Decimal(4, 2) // 0.00–1.00
  recommendation  String           @map("recommendation")
  figuresIncluded Int              @map("figures_included") // jumlah figur yang is_known = true
  createdAt       DateTime         @default(now()) @map("created_at")
  assessment      FamilyAssessment @relation(fields: [assessmentId], references: [id])

  @@map("family_results")
}
